{
  "name": "@elevenid/marty-blog",
  "version": "0.1.7",
  "description": "Marty Identity Protocol blog - posts, authors, and protocol guide",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElevenID/marty-blog.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./blog-page": {
      "import": "./dist/blog-page.js",
      "default": "./dist/blog-page.js"
    },
    "./blog-post-page": {
      "import": "./dist/blog-post-page.js",
      "default": "./dist/blog-post-page.js"
    },
    "./authors-page": {
      "import": "./dist/authors-page.js",
      "default": "./dist/authors-page.js"
    },
    "./author-page": {
      "import": "./dist/author-page.js",
      "default": "./dist/author-page.js"
    },
    "./foundations-page": {
      "import": "./dist/foundations-page.js",
      "default": "./dist/foundations-page.js"
    },
    "./prerender-data": {
      "import": "./dist/prerender-data.js",
      "default": "./dist/prerender-data.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "export:social-manifest": "node scripts/export-social-manifest.mjs",
    "export:social-image-manifest": "node scripts/export-social-image-manifest.mjs",
    "export:grammar-review": "node scripts/export-grammar-review-manifest.mjs",
    "lint": "eslint src --ext .js,.jsx",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=5",
    "@mui/material": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=8.3.0"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-x": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
